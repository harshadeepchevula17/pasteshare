# Spring Boot / Neon PostgreSQL
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=replace_with_your_database_password

# Backend production configuration
PASTESHARE_PUBLIC_BASE_URL=https://your-pasteshare-frontend.vercel.app
PASTESHARE_ALLOWED_ORIGIN=https://your-pasteshare-frontend.vercel.app
PASTESHARE_MAX_CONTENT_LENGTH=100000
PASTESHARE_ID_GENERATION_ATTEMPTS=5

# Frontend production build configuration
VITE_API_BASE_URL=https://your-pasteshare-api.onrender.com
VITE_MAX_CONTENT_LENGTH=100000
